new file mode 100644
--- /dev/null
+++ b/Sources/SourceKitXcodeBSP/Bootstrap/KnowCodeBuildServer.swift
@@ -0,0 +1,136 @@
+// Modified by Know Code contributors in 2026; see tooling/xcode-bridge/MODIFICATIONS.md in the Know Code source.
+import Foundation
+import BuildServerProtocol
+import LanguageServerProtocol
+import LanguageServerProtocolTransport
+import SwiftBuild
+
+/// Preserve the public planner/navigation implementation. Only preparation is
+/// intercepted because its upstream RPC discards the typed service outcome.
+final class KnowCodeBuildServer: MessageHandler {
+    let server: SWBBuildServer
+    let preparation: TypedIndexPreparation
+
+    init(server: SWBBuildServer, preparation: TypedIndexPreparation) {
+        self.server = server; self.preparation = preparation
+    }
+    func handle(_ notification: some NotificationType) { server.handle(notification) }
+    func handle<Request: RequestType>(_ request: Request, id: RequestID,
+        reply: @Sendable @escaping (LSPResult<Request.Response>) -> Void) {
+        if let prepare = request as? BuildTargetPrepareRequest {
+            Task {
+                do {
+                    try await preparation.prepare(targets: prepare.targets)
+                    guard let response = BuildTargetPrepareResponse() as? Request.Response else {
+                        throw PreparationFailure("Incompatible typed preparation response")
+                    }
+                    reply(.success(response))
+                } catch { reply(.failure(.unknown(error.localizedDescription))) }
+            }
+        } else {
+            server.handle(request, id: id) { result in
+                if case .success(let response) = result, let inventory = response as? WorkspaceBuildTargetsResponse {
+                    Task { await self.preparation.setTargets(inventory.targets.map(\.id)); reply(result) }
+                } else { reply(result) }
+            }
+        }
+    }
+}
+
+actor TypedIndexPreparation {
+    private let session: SWBBuildServiceSession
+    private let request: SWBBuildRequest
+    private let proofPath: URL
+    private let pifSha256: String
+    private var targets: Set<BuildTargetIdentifier>?
+    private var attempted = false
+
+    init(session: SWBBuildServiceSession, request: SWBBuildRequest, proofPath: URL, pifSha256: String) {
+        self.session = session; self.request = request; self.proofPath = proofPath; self.pifSha256 = pifSha256
+    }
+    func setTargets(_ targets: [BuildTargetIdentifier]) { self.targets = Set(targets) }
+
+    func prepare(targets requested: [BuildTargetIdentifier]) async throws {
+        // The adapter prepares the entire selected context once. Validate the
+        // exact planner-returned opaque IDs, without parsing their URI shape.
+        guard let targets, !targets.isEmpty, Set(requested) == targets else {
+            throw PreparationFailure("Prepare requires the entire selected scheme target inventory")
+        }
+        guard !attempted else { throw PreparationFailure("Preparation already attempted; start a fresh immutable analysis job") }
+        attempted = true
+        var prepared = request
+        prepared.buildCommand = .prepareForIndexing(buildOnlyTheseTargets: request.configuredTargets.map(\.guid), enableIndexBuildArena: true)
+        let operation = try await session.createBuildOperation(request: prepared, delegate: IndexPlanningDelegate())
+        struct EventEvidence: Sendable {
+            let terminals: [String]
+            let completed: Int
+            let diagnostics: [String]
+            let droppedDiagnostics: Int
+        }
+        let events = try await operation.start()
+        // Mutable collection belongs entirely to this operation closure. Only
+        // its immutable Sendable value crosses back into proof construction.
+        let evidence = await withTaskCancellationHandler {
+            var terminals = [String](), completed = 0, diagnostics = [String](), droppedDiagnostics = 0
+            for await event in events {
+                var message: String?
+                switch event {
+                case .buildCompleted(let info): terminals.append(info.result.rawValue)
+                case .preparationComplete: completed += 1
+                case .buildDiagnostic(let info): message = info.message
+                case .taskDiagnostic(let info): message = info.message
+                case .targetDiagnostic(let info): message = info.message
+                case .diagnostic(let info): message = info.message
+                default: break // Compiler/project log strings cannot assert success.
+                }
+                if let message {
+                    if diagnostics.count < 100 { diagnostics.append(String(message.prefix(1024))) }
+                    else { droppedDiagnostics += 1 }
+                }
+            }
+            await operation.waitForCompletion()
+            return EventEvidence(terminals: terminals, completed: completed,
+                diagnostics: diagnostics, droppedDiagnostics: droppedDiagnostics)
+        } onCancel: { operation.cancel() }
+        let state: String
+        switch operation.state {
+        case .requested: state = "requested"
+        case .running: state = "running"
+        case .succeeded: state = "succeeded"
+        case .failed: state = "failed"
+        case .cancelled: state = "cancelled"
+        case .aborted: state = "aborted"
+        @unknown default: state = "unknown"
+        }
+        let succeeded = evidence.terminals == ["ok"] && evidence.completed > 0 && state == "succeeded"
+        struct Proof: Encodable {
+            let typedTerminalResults: [String]
+            let typedPreparationCompleteCount: Int
+            let operationState: String
+            let succeeded: Bool
+            let pifSha256: String
+            let configuredRootGUIDs: [String]
+            let configurationName: String?
+            let requestedTargetURIs: [String]
+            let diagnostics: [String]
+            let droppedDiagnostics: Int
+        }
+        let proof = Proof(typedTerminalResults: evidence.terminals, typedPreparationCompleteCount: evidence.completed,
+            operationState: state, succeeded: succeeded, pifSha256: pifSha256,
+            configuredRootGUIDs: request.configuredTargets.map(\.guid), configurationName: request.parameters.configurationName,
+            requestedTargetURIs: requested.map { $0.uri.stringValue }, diagnostics: evidence.diagnostics, droppedDiagnostics: evidence.droppedDiagnostics)
+        let encoder = JSONEncoder(); encoder.outputFormatting = [.prettyPrinted, .sortedKeys, .withoutEscapingSlashes]
+        try encoder.encode(proof).write(to: proofPath, options: .atomic)
+        guard succeeded else { throw PreparationFailure("Typed indexing preparation did not succeed: terminal=\(evidence.terminals), state=\(state), preparationComplete=\(evidence.completed)") }
+    }
+}
+
+private struct PreparationFailure: Error, LocalizedError {
+    let errorDescription: String?
+    init(_ message: String) { errorDescription = message }
+}
+
+private final class IndexPlanningDelegate: SWBPlanningOperationDelegate, Sendable {
+    func provisioningTaskInputs(targetGUID: String, provisioningSourceData: SWBProvisioningTaskInputsSourceData) async -> SWBProvisioningTaskInputs { .init() }
+    func executeExternalTool(commandLine: [String], workingDirectory: String?, environment: [String: String]) async throws -> SWBExternalToolResult { .deferred }
+}
