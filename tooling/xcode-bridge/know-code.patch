+// Modified by Know Code contributors in 2026; see tooling/xcode-bridge/MODIFICATIONS.md in the Know Code source.
+import Foundation
+import CryptoKit
+
+/// Resolve build selection from the saved scheme, native project and the exact
+/// compiler-exported PIF that will be loaded by the service. This never derives
+/// a planner GUID from a native identifier or uses a name outside its project.
+struct XcodeSchemeSelection: Sendable, Codable {
+    struct Target: Sendable, Codable {
+        let projectPath: String
+        let nativeIdentifier: String
+        let nativeName: String
+        let plannerIdentifier: String
+    }
+    let schemePath: String
+    let configuration: String
+    let targets: [Target]
+    let inputPaths: [String]
+    let inputSha256: [String: String]
+
+    static func resolve(workspacePath: String, selectedPath: String?, pif: Data) throws -> Self {
+        guard let objects = try JSONSerialization.jsonObject(with: pif) as? [[String: Any]],
+              objects.first?["type"] as? String == "workspace" else {
+            throw SelectionError("Unsupported compiler PIF export; expected workspace-first object array")
+        }
+        var bySignature = [String: [String: Any]]()
+        for object in objects {
+            guard let kind = object["type"] as? String, let signature = object["signature"] as? String,
+                  let contents = object["contents"] as? [String: Any],
+                  bySignature["\(kind):\(signature)"] == nil else {
+                throw SelectionError("Invalid, duplicate or unsupported compiler PIF object")
+            }
+            bySignature["\(kind):\(signature)"] = contents
+        }
+        let projects = objects.filter { $0["type"] as? String == "project" }.compactMap { $0["contents"] as? [String: Any] }
+        var containers = Set([canonical(workspacePath)])
+        for project in projects {
+            guard let filename = project["path"] as? String else { throw SelectionError("Compiler PIF project lacks a path") }
+            containers.insert(canonical(filename))
+        }
+        let shared = try sharedPaths(containers: containers)
+        let path: String
+        if let selectedPath {
+            path = canonical(selectedPath)
+            guard shared.contains(path) else { throw SelectionError("Selected scheme is not a shared scheme in this workspace: \(selectedPath)") }
+        } else {
+            guard shared.count == 1, let only = shared.first else {
+                throw SelectionError("Select one shared scheme with swift.scheme; found \(shared.count): \(shared.sorted().joined(separator: ", "))")
+            }
+            path = only
+        }
+        let (data, delegate, configuration) = try readSavedScheme(path)
+        let container = URL(fileURLWithPath: path).deletingLastPathComponent().deletingLastPathComponent().deletingLastPathComponent()
+        var resolved = [Target](), inputs = [path: data], seen = Set<String>()
+        for reference in delegate.references {
+            guard reference.container.hasPrefix("container:") else { throw SelectionError("Unsupported scheme referenced container: \(reference.container)") }
+            let relative = String(reference.container.dropFirst("container:".count))
+            let nativeProject = canonical(container.deletingLastPathComponent().appendingPathComponent(relative).path)
+            let matches = projects.filter { ($0["path"] as? String).map(canonical) == nativeProject }
+            guard matches.count == 1, let project = matches.first,
+                  let signatures = project["targets"] as? [String] else {
+                throw SelectionError("Referenced native project has no unique compiler PIF project: \(nativeProject)")
+            }
+            let filename = URL(fileURLWithPath: nativeProject).appendingPathComponent("project.pbxproj").path
+            if inputs[filename] == nil { inputs[filename] = try boundedXcodeData(filename) }
+            guard let bytes = inputs[filename],
+                  let pbx = try PropertyListSerialization.propertyList(from: bytes, options: [], format: nil) as? [String: Any],
+                  let nativeObjects = pbx["objects"] as? [String: [String: Any]],
+                  let root = pbx["rootObject"] as? String,
+                  let ids = nativeObjects[root]?["targets"] as? [String], ids.contains(reference.identifier),
+                  let native = nativeObjects[reference.identifier], let name = native["name"] as? String,
+                  ["PBXNativeTarget", "PBXAggregateTarget"].contains(native["isa"] as? String ?? ""),
+                  ids.filter({ nativeObjects[$0]?["name"] as? String == name }).count == 1 else {
+                throw SelectionError("Scheme target lacks an unambiguous native project identity: \(reference.identifier)")
+            }
+            let candidates = try signatures.map { signature -> [String: Any] in
+                guard let target = bySignature["target:\(signature)"] else { throw SelectionError("Compiler PIF project references a missing target") }
+                return target
+            }.filter { $0["name"] as? String == name }
+            guard candidates.count == 1, let target = candidates.first, let guid = target["guid"] as? String,
+                  let configs = target["buildConfigurations"] as? [[String: Any]],
+                  configs.filter({ $0["name"] as? String == configuration }).count == 1 else {
+                throw SelectionError("Native target \(name) has no unique compiler target/configuration \(configuration) in \(nativeProject)")
+            }
+            if seen.insert(guid).inserted {
+                resolved.append(Target(projectPath: nativeProject, nativeIdentifier: reference.identifier, nativeName: name, plannerIdentifier: guid))
+            }
+        }
+        return Self(schemePath: path, configuration: configuration, targets: resolved, inputPaths: inputs.keys.sorted(),
+            inputSha256: inputs.mapValues { SHA256.hash(data: $0).map { String(format: "%02x", $0) }.joined() })
+    }
+
+    /// CLI preparation/export uses the same saved Test policy as native/PIF
+    /// selection. This is build selection, never semantic symbol identity.
+    struct MetadataContext: Sendable, Codable {
+        let schemePath: String
+        let schemeName: String
+        let configuration: String
+        let schemeSha256: String
+    }
+
+    static func metadataContext(workspacePath: String, selectedPath: String?) throws -> MetadataContext {
+        let path: String
+        if let selectedPath {
+            path = canonical(selectedPath)
+        } else {
+            let shared = try sharedPaths(containers: Set([canonical(workspacePath)]))
+            guard shared.count == 1, let only = shared.first else {
+                throw SelectionError("Metadata requires one saved shared scheme; select swift.scheme when the container has \(shared.count) direct shared schemes (including nested-project-only schemes)")
+            }
+            path = only
+        }
+        let url = URL(fileURLWithPath: path)
+        guard url.pathExtension == "xcscheme",
+              url.deletingLastPathComponent().lastPathComponent == "xcschemes",
+              url.deletingLastPathComponent().deletingLastPathComponent().lastPathComponent == "xcshareddata" else {
+            throw SelectionError("Metadata requires a saved shared .xcscheme path")
+        }
+        let (bytes, _, configuration) = try readSavedScheme(path)
+        let name = url.deletingPathExtension().lastPathComponent
+        guard !name.isEmpty else { throw SelectionError("Selected shared scheme has an empty CLI name") }
+        // Exact membership, native identities and configuration support are
+        // checked against compiler PIF after export, before loading the service.
+        return MetadataContext(schemePath: path, schemeName: name, configuration: configuration,
+            schemeSha256: SHA256.hash(data: bytes).map { String(format: "%02x", $0) }.joined())
+    }
+
+    private static func sharedPaths(containers: Set<String>) throws -> Set<String> {
+        var shared = Set<String>()
+        for container in containers where ["xcodeproj", "xcworkspace"].contains(URL(fileURLWithPath: container).pathExtension) {
+            let directory = URL(fileURLWithPath: container).appendingPathComponent("xcshareddata/xcschemes")
+            if FileManager.default.fileExists(atPath: directory.path) {
+                for file in try FileManager.default.contentsOfDirectory(at: directory, includingPropertiesForKeys: nil)
+                    where file.pathExtension == "xcscheme" { shared.insert(canonical(file.path)) }
+            }
+        }
+        return shared
+    }
+
+    private static func readSavedScheme(_ path: String) throws -> (Data, SchemeXML, String) {
+        let data = try boundedXcodeData(path)
+        guard let xml = String(data: data, encoding: .utf8),
+              !xml.contains("<!DOCTYPE"), !xml.contains("<!ENTITY") else {
+            throw SelectionError("Unsupported or oversized saved Xcode scheme")
+        }
+        let delegate = SchemeXML()
+        let parser = XMLParser(data: data)
+        parser.shouldResolveExternalEntities = false
+        parser.delegate = delegate
+        guard parser.parse(), delegate.testActions == 1, !delegate.invalidReference,
+              let configuration = delegate.configuration, !configuration.isEmpty else {
+            throw SelectionError("Selected shared scheme requires a valid Test action with an explicit buildConfiguration")
+        }
+        guard !delegate.hasTestPlans else { throw SelectionError("Selected scheme uses test plans; test-plan target selection is not implemented") }
+        guard !delegate.references.isEmpty else { throw SelectionError("Selected scheme has no test-build or Test action targets") }
+        return (data, delegate, configuration)
+    }
+
+    private static func canonical(_ path: String) -> String {
+        URL(fileURLWithPath: path).standardizedFileURL.resolvingSymlinksInPath().path
+    }
+
+}
+
+func boundedXcodeData(_ path: String, maximumBytes: Int = 8 * 1024 * 1024) throws -> Data {
+        let file = try FileHandle(forReadingFrom: URL(fileURLWithPath: path))
+        defer { try? file.close() }
+        var data = Data()
+        while let part = try file.read(upToCount: 64 * 1024), !part.isEmpty {
+            guard data.count + part.count <= maximumBytes else { throw SelectionError("Saved Xcode input exceeds research limit: \(path)") }
+            data.append(part)
+        }
+        return data
+}
+
+private struct SelectionError: Error, LocalizedError {
+    let errorDescription: String?
+    init(_ message: String) { errorDescription = message }
+}
+
+private final class SchemeXML: NSObject, XMLParserDelegate {
+    struct Reference { let identifier: String; let container: String }
+    var configuration: String?
+    var testActions = 0
+    var invalidReference = false
+    var hasTestPlans = false
+    var references = [Reference]()
+    private var stack = [String]()
+    private var includeBuildEntry = false
+    private var includeTestable = false
+
+    func parser(_ parser: XMLParser, didStartElement elementName: String, namespaceURI: String?, qualifiedName qName: String?, attributes attrs: [String: String]) {
+        stack.append(elementName)
+        if stack == ["Scheme", "TestAction"] { testActions += 1; configuration = attrs["buildConfiguration"] }
+        if stack == ["Scheme", "TestAction", "TestPlans"] { hasTestPlans = true }
+        if stack == ["Scheme", "BuildAction", "BuildActionEntries", "BuildActionEntry"] { includeBuildEntry = attrs["buildForTesting"] == "YES" }
+        if stack == ["Scheme", "TestAction", "Testables", "TestableReference"] { includeTestable = attrs["skipped"] != "YES" }
+        let build = stack == ["Scheme", "BuildAction", "BuildActionEntries", "BuildActionEntry", "BuildableReference"] && includeBuildEntry
+        let test = stack == ["Scheme", "TestAction", "Testables", "TestableReference", "BuildableReference"] && includeTestable
+        if build || test {
+            if let identifier = attrs["BlueprintIdentifier"], !identifier.isEmpty,
+               let container = attrs["ReferencedContainer"], !container.isEmpty {
+                references.append(Reference(identifier: identifier, container: container))
+            } else { invalidReference = true }
+        }
+    }
+    func parser(_ parser: XMLParser, didEndElement elementName: String, namespaceURI: String?, qualifiedName qName: String?) {
+        stack.removeLast()
+    }
+}
