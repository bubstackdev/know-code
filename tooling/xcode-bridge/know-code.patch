diff --git a/Sources/SourceKitXcodeBSP/Xcode/PIFExport.swift b/Sources/SourceKitXcodeBSP/Xcode/PIFExport.swift
new file mode 100644
--- /dev/null
+++ b/Sources/SourceKitXcodeBSP/Xcode/PIFExport.swift
@@ -0,0 +1,88 @@
+// Modified by Know Code contributors in 2026; see tooling/xcode-bridge/MODIFICATIONS.md in the Know Code source.
+import Foundation
+import CryptoKit
+
+struct OwnedPIFExport: Sendable {
+    let path: String
+    let sha256: String
+    let selection: XcodeSchemeSelection
+
+    static func create(workspacePath: String, schemePath: String?, buildRoot: String,
+        clonedSourcePackagesDirPath: String?, packageCachePath: String?) async throws -> Self {
+        let clones = try preparedDirectory(clonedSourcePackagesDirPath, field: "clonedSourcePackagesDirPath")
+        let cache = try preparedDirectory(packageCachePath, field: "packageCachePath")
+        let context = try XcodeSchemeSelection.metadataContext(workspacePath: workspacePath, selectedPath: schemePath)
+        let root = URL(fileURLWithPath: buildRoot).standardizedFileURL.resolvingSymlinksInPath()
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)
+        let metadataDerivedData = root.appendingPathComponent("metadata-derived").path
+        let output = root.appendingPathComponent("know-code-project.pif.json")
+        if FileManager.default.fileExists(atPath: output.path) { try FileManager.default.removeItem(at: output) }
+        let kind = URL(fileURLWithPath: workspacePath).pathExtension
+        guard ["xcodeproj", "xcworkspace"].contains(kind) else {
+            throw NSError(domain: "KnowCodeXcodeSelection", code: 1, userInfo: [NSLocalizedDescriptionKey: "Expected an Xcode project or workspace container"])
+        }
+        let arguments = ["xcodebuild", "-dumpPIF", output.path, kind == "xcodeproj" ? "-project" : "-workspace", workspacePath,
+            "-scheme", context.schemeName, "-configuration", context.configuration, "-derivedDataPath", metadataDerivedData,
+            "-clonedSourcePackagesDirPath", clones, "-packageCachePath", cache,
+            "-disableAutomaticPackageResolution", "-onlyUsePackageVersionsFromResolvedFile", "-skipPackageUpdates"]
+        // Retain the exact attempted metadata command even when the selected
+        // tool rejects an absent/incomplete prepared cache. This is not a
+        // preparation or successful-export checkpoint.
+        let attempt = ["arguments": arguments, "clonedSourcePackagesDirPath": clones,
+            "packageCachePath": cache, "packageVersionPolicy": "saved_lock_versions_no_updates",
+            "metadataDerivedDataPath": metadataDerivedData, "metadataSchemePath": context.schemePath,
+            "metadataSchemeName": context.schemeName, "metadataConfiguration": context.configuration,
+            "metadataSchemeSha256": context.schemeSha256,
+            "cliFlagsGuaranteeOfflineExecution": false] as [String: Any]
+        try JSONSerialization.data(withJSONObject: attempt, options: [.prettyPrinted, .sortedKeys, .withoutEscapingSlashes])
+            .write(to: root.appendingPathComponent("know-code-project-export-request.json"), options: .atomic)
+        let capture = try await ProcessRunner().run(executableURL: URL(fileURLWithPath: "/usr/bin/xcrun"), arguments: arguments, monitoredFile: output)
+        let bytes = try boundedXcodeData(output.path, maximumBytes: 64 * 1024 * 1024)
+        let digest = SHA256.hash(data: bytes).map { String(format: "%02x", $0) }.joined()
+        let selected = try XcodeSchemeSelection.resolve(workspacePath: workspacePath, selectedPath: schemePath, pif: bytes)
+        guard selected.schemePath == context.schemePath, selected.configuration == context.configuration,
+              selected.inputSha256[context.schemePath] == context.schemeSha256 else {
+            throw NSError(domain: "KnowCodeXcodeSelection", code: 2,
+                userInfo: [NSLocalizedDescriptionKey: "Saved scheme changed during metadata export; refresh from a coherent saved snapshot"])
+        }
+        struct Proof: Encodable {
+            let arguments: [String]
+            let pifPath: String
+            let pifSha256: String
+            let pifBytes: Int
+            let selection: XcodeSchemeSelection
+            let metadataStdout: String
+            let metadataStderr: String
+            let filesystemReloadDisabled: Bool
+            let clonedSourcePackagesDirPath: String
+            let packageCachePath: String
+            let packageVersionPolicy: String
+            let cliFlagsGuaranteeOfflineExecution: Bool
+            let metadataDerivedDataPath: String
+            let metadataContext: XcodeSchemeSelection.MetadataContext
+        }
+        let proof = Proof(arguments: arguments, pifPath: output.path, pifSha256: digest, pifBytes: bytes.count,
+            selection: selected, metadataStdout: String(decoding: capture.stdout, as: UTF8.self),
+            metadataStderr: String(decoding: capture.stderr, as: UTF8.self), filesystemReloadDisabled: true,
+            clonedSourcePackagesDirPath: clones, packageCachePath: cache,
+            packageVersionPolicy: "saved_lock_versions_no_updates", cliFlagsGuaranteeOfflineExecution: false,
+            metadataDerivedDataPath: metadataDerivedData, metadataContext: context)
+        let encoder = JSONEncoder(); encoder.outputFormatting = [.prettyPrinted, .sortedKeys, .withoutEscapingSlashes]
+        try encoder.encode(proof).write(to: root.appendingPathComponent("know-code-selected-scheme.json"), options: .atomic)
+        return Self(path: output.path, sha256: digest, selection: selected)
+    }
+    private static func preparedDirectory(_ value: String?, field: String) throws -> String {
+        guard let value, value.hasPrefix("/"), !value.contains("\0"),
+              URL(fileURLWithPath: value).standardizedFileURL.path == value else {
+            throw NSError(domain: "KnowCodeXcodePreparation", code: 1,
+                userInfo: [NSLocalizedDescriptionKey: "Xcode analysis requires a job-owned absolute normalized \(field); update the coordinator/bridge configuration"])
+        }
+        var directory: ObjCBool = false
+        guard FileManager.default.fileExists(atPath: value, isDirectory: &directory), directory.boolValue,
+              FileManager.default.isReadableFile(atPath: value) else {
+            throw NSError(domain: "KnowCodeXcodePreparation", code: 2,
+                userInfo: [NSLocalizedDescriptionKey: "Prepared Xcode dependency cache is missing or unreadable: \(field)=\(value). Run common dependency preparation, then refresh; analysis does not create this cache directory."])
+        }
+        return URL(fileURLWithPath: value).resolvingSymlinksInPath().path
+    }
+}
