package main

// The route labeller's dump (scripts/eval/routes/go/list.sh): when the program would start serving, print its router's
// own route listing and exit. Overlaid into the program's main package (or a library's package, for a test harness).

import (
	"encoding/json"
	"fmt"
	"net/http"
	"os"
	"reflect"
	"runtime"
	"strings"
	//IMPORTS
)

type kcRoute struct {
	Framework string `json:"framework"`
	Method    string `json:"method"`
	Path      string `json:"path"`
	Handler   string `json:"handler"`
	Loc       string `json:"loc,omitempty"`
}

// kcMounts are the mount points already listed (chi).
var kcMounts = map[string]bool{}

var _ = strings.Contains

// kcOut prints one route row, marked so list.sh tells it from the program's own output.
func kcOut(r kcRoute) {
	b, _ := json.Marshal(r)
	fmt.Printf("{\"t\": \"route\", %s\n", b[1:])
}

// kcOutAt prints a route once per registration site its framework's hook recorded under key (routes-v1.1), or once
// without one when no hook ran.
func kcOutAt(r kcRoute, sites map[string][]string, key string) {
	if len(sites[key]) == 0 {
		kcOut(r)
		return
	}
	for _, s := range sites[key] {
		r.Loc = s
		kcOut(r)
	}
}

// kcChiKey finds a chi route's sites: chi records them by endpoint handler and the pattern its own (sub)router has,
// and walks the full route; the longest tail of the route that the same handler was registered under is the one.
// The handler is the endpoint as registered, before route middleware wraps it, which is what chi.Walk hands back;
// a handler shared by several routes (one wrapper's closure) is told apart by the pattern.
func kcChiKey(sites map[string][]string, handler, route string) string {
	segs := strings.Split(strings.TrimPrefix(route, "/"), "/")
	for i := range segs {
		if k := handler + " /" + strings.Join(segs[i:], "/"); len(sites[k]) > 0 {
			return k
		}
	}
	if k := handler + " /"; len(sites[k]) > 0 {
		return k
	}
	return ""
}

func kcFuncName(v interface{}) string {
	rv := reflect.ValueOf(v)
	if rv.Kind() == reflect.Func {
		if f := runtime.FuncForPC(rv.Pointer()); f != nil {
			return f.Name()
		}
	}
	return reflect.TypeOf(v).String()
}

// kcMux lists the patterns mux registered, with where each was registered.
func kcMux(mux *http.ServeMux) {
	for _, g := range http.KCRegistrations {
		if g.Mux == mux {
			kcOut(kcRoute{Framework: "net/http", Path: g.Pattern, Handler: kcFuncName(g.Handler), Loc: g.Loc})
		}
	}
}

func init() {
	http.KCServeHook = func(h http.Handler) {
		if h == nil {
			h = http.DefaultServeMux
		}
		switch r := h.(type) {
		case *http.ServeMux:
			kcMux(r)
		//CASES
		default:
			// A handler wrapping the router (middleware, a function): what it serves can't be listed, and list.sh
			// counts the program as listing nothing.
			kcOut(kcRoute{Framework: "unknown", Handler: reflect.TypeOf(h).String()})
		}
		os.Exit(0)
	}
}
